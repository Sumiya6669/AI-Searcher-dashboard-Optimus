# Адрес проекта Supabase и публикуемый ключ. Оба значения попадают в браузер
# по назначению: без них невозможен вход. Разграничение доступа обеспечивают
# политики RLS в базе, а не сокрытие этих двух значений.
NEXT_PUBLIC_SUPABASE_URL=https://ajmwzzahcdtkikzhxzqu.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Базовый адрес приложения. Нужен для ссылок в письмах сброса пароля.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Адрес n8n. Используется только для ссылок на выполнения сценариев.
# Токен n8n здесь не нужен и не должен появляться.
NEXT_PUBLIC_N8N_BASE_URL=https://optimusalbertgaan.app.n8n.cloud

# Демонстрационный режим. 1 — данные берутся из изолированного набора,
# запросов к базе не выполняется. Для production оставить пустым.
DASHBOARD_DEMO=

# СЕРВИСНЫЙ КЛЮЧ SUPABASE ЗДЕСЬ НЕ ИСПОЛЬЗУЕТСЯ И НЕ ДОЛЖЕН БЫТЬ ЗАДАН.
# Всё чтение идёт от имени вошедшего пользователя, чтобы права проверяла база.
